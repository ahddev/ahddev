# Resend: sending + inbound (the API key needs full access, not "sending only")
RESEND_API_KEY=
# Default sender. A display name is used for every address you send from:
#   RESEND_FROM="Your Name <reach@yourdomain.com>"
RESEND_FROM=reach@yourdomain.com
# Signing secret of the webhook pointing at /api/webhooks/resend (required)
RESEND_WEBHOOK_SECRET=

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the inbound webhook, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:reach@yourdomain.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
